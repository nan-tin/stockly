<div class="-mx-4 -mt-6 min-h-screen bg-stone-100 pb-24">
  <header class="relative flex h-20 items-center justify-center bg-white">
    <%= link_to settings_path,
          class: "absolute left-4 flex items-center text-stone-900",
          aria: { label: "設定画面へ戻る" } do %>
      <%= heroicon "chevron-left", type: :outline, class: "h-7 w-7" %>
      <span class="text-sm">設定</span>
    <% end %>

    <h1 class="text-xl font-bold text-stone-900">
      カテゴリー編集
    </h1>
  </header>

  <main class="px-4 pt-10">
    <div class="mx-auto max-w-md rounded-xl bg-white px-7 pb-6 pt-4">
      <%= render "form",
            category: @category,
            submit_text: "完了",
            placeholder_text: "名前を入力してください" %>
    </div>
  </main>
</div>